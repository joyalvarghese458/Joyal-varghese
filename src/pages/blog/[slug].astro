---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GridPaper from '../../components/GridPaper.astro';
import Marker from '../../components/Marker.astro';
import HandLink from '../../components/HandLink.astro';
import { readingMinutes } from '../../lib/blog';

export async function getStaticPaths() {
  return (await getCollection('blog')).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { Content } = await render(post);
const related = (await getCollection('blog')).filter((entry) => entry.id !== post.id).slice(0, 2);
const author = (await getCollection('profile'))[0].data;
const dateLabel = new Date(`${post.data.date}T12:00:00+04:00`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Dubai' });
const articleUrl = Astro.site ? new URL(`/blog/${post.id}/`, Astro.site).href : undefined;
const structuredData = {
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  headline: post.data.title, description: post.data.description,
  datePublished: `${post.data.date}T12:00:00+04:00`,
  author: { '@type': 'Person', name: author.name, url: author.contacts.find((contact) => contact.sub === 'linkedin')?.url },
  mainEntityOfPage: articleUrl, url: articleUrl, inLanguage: 'en', articleSection: post.data.tag,
};
---
<Base title={`${post.data.title} | ${author.name}`} description={post.data.description} type="article" structuredData={structuredData}>
  <GridPaper size={22} class="article-paper">
    <article class="article">
      <nav aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/blog/">Mini blog</a></nav>
      <header>
        <span class="topic">#{post.data.tag}</span>
        <Marker as="h1" size="clamp(28px, 5vw, 48px)">{post.data.title}</Marker>
        <p class="byline">By <a href="/#contact">{author.name}</a> · <time datetime={post.data.date}>{dateLabel}</time> · {readingMinutes(post.body)} min read</p>
        <p class="intro">{post.data.description}</p>
      </header>
      <div class="prose"><Content /></div>
      <aside class="author-note" aria-label="About the author">
        <strong>About Joyal</strong>
        <p>I'm a full stack software developer based in Sharjah, UAE. My work includes React interfaces, NestJS APIs, and ERP systems for business operations.</p>
        <HandLink href="/projects/">Explore my projects →</HandLink>
        <span> · </span><HandLink href="/#contact">Get in touch →</HandLink>
      </aside>
      <footer>
        <h2>More from the notebook</h2>
        <ul>{related.map((entry) => <li><a href={`/blog/${entry.id}/`}>{entry.data.title}</a></li>)}</ul>
        <HandLink href="/blog/">← All mini blogs</HandLink>
      </footer>
    </article>
  </GridPaper>
</Base>
<style>
  .article-paper { min-height: 100vh; }
  .article { max-width: 820px; margin: 0 auto; padding: 28px clamp(20px, 5vw, 48px) 64px; color: var(--nb-ink, #1a1a1a); overflow-wrap: anywhere; }
  nav, .byline { font-family: 'JetBrains Mono', monospace; font-size: 11px; line-height: 1.9; }
  nav { margin-bottom: 28px; }
  .topic { display: table; padding: 3px 10px; background: #ffe45c; transform: rotate(-2deg); font-family: 'Kalam', cursive; }
  header :global(h1) { margin: 20px 0 12px; }
  .intro { font-family: 'Kalam', cursive; font-size: clamp(21px, 3vw, 26px); line-height: 1.5; border-bottom: 1px dashed #777; padding-bottom: 22px; }
  .prose { font-family: system-ui, sans-serif; font-size: 17px; line-height: 1.85; }
  .prose :global(h2), footer h2 { font-family: 'Kalam', cursive; font-size: 28px; line-height: 1.3; margin: 30px 0 12px; }
  .prose :global(li) { margin-bottom: 10px; }
  .article :global(a) { color: #923b2f; text-underline-offset: 4px; }
  .article :global(a:focus-visible) { outline: 2px solid currentColor; outline-offset: 4px; }
  .author-note { background: #fff3b5; padding: 22px; margin: 32px 0; border-radius: 3px; font-family: 'Kalam', cursive; font-size: 21px; }
  .author-note p { margin: 8px 0; }
  footer { font-family: 'Kalam', cursive; font-size: 22px; }
  footer li { margin-bottom: 12px; }
</style>
