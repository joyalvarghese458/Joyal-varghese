---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GridPaper from '../../components/GridPaper.astro';
import Hand from '../../components/Hand.astro';
import Marker from '../../components/Marker.astro';
import Mono from '../../components/Mono.astro';
import HandLink from '../../components/HandLink.astro';
import StickyNote from '../../components/StickyNote.astro';
import PhotoCutout from '../../components/PhotoCutout.astro';
import { NB } from '../../lib/notebook';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const p = entry.data;
const cs = p.caseStudy;
const hasLinks = Boolean(p.links.live || p.links.github || p.links.linkedin || p.links.playStore);

// Build sorted list to find next project (wrap around by order)
const allEntries = await getCollection('projects');
const sorted = allEntries.sort((a, b) => a.data.order - b.data.order);
const currentIdx = sorted.findIndex((e) => e.id === entry.id);
const nextEntry = sorted[(currentIdx + 1) % sorted.length];

const pageUrl = Astro.site ? new URL(`/case-studies/${entry.id}/`, Astro.site).href : undefined;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: `${p.title}: software development case study`,
  description: p.subtitle,
  url: pageUrl,
  inLanguage: 'en',
  author: { '@type': 'Person', name: 'Joyal Varghese', url: Astro.site ? new URL('/about/', Astro.site).href : undefined },
  about: p.stack.map((name) => ({ '@type': 'Thing', name })),
  ...(p.heroImage && Astro.site ? { image: new URL(p.heroImage, Astro.site).href } : {}),
};
---

<Base
  title={`${p.title} | Software Developer Case Study`}
  description={p.subtitle}
  structuredData={structuredData}
>
  <GridPaper size={22} style="min-height: 100vh;">

    {/* ── Page header ── */}
    <header class="page-header">
      <div class="header-left">
        <HandLink href="/case-studies/" color={NB.pencil} class="back-link">
          <Hand size={18} color={NB.pencil} as="span">← all case studies</Hand>
        </HandLink>
        <Marker size="clamp(32px, 7vw, 60px)" as="p" class="page-title">
          Case Study.
        </Marker>
      </div>
      <div class="header-right">
        <Mono size={9} class="header-tag-mobile">joyal.varghese</Mono>
        <Mono size={11} class="header-tag-desktop">joyal.varghese / portfolio.2026</Mono>
      </div>
    </header>

    {/* ── Body ── */}
    <article class="page-body">

      {/* ── Title block ── */}
      <div class="title-block">
        <Mono size={9} color={NB.red} as="span" class="project-label">
          PROJECT{p.year && ` · ${p.year}`}
        </Mono>
        <Marker size="clamp(38px, 9vw, 84px)" as="h1" class="project-name">
          {p.title}.
        </Marker>
        <Hand size="clamp(18px, 3.5vw, 30px)" color={NB.inkSoft} as="p" class="project-subtitle">
          {p.subtitle}
        </Hand>
      </div>

      {/* ── Hero image ── */}
      {p.heroImage && (<div class="hero-wrap" data-reveal>
        <PhotoCutout
          width="100%"
          height={200}
          rotate={-1.5}
          label="hero screenshot"
          src={p.heroImage ?? undefined}
          alt={`${p.title}: screenshot`}
          class="hero-photo"
        />
      </div>)}

      {/* ── Meta strip ── */}
      <dl class="meta-strip" data-reveal>
        <div class="meta-item">
          <Mono size={9} as="dt">ROLE</Mono>
          <Hand size={17} as="dd" class="meta-value">{cs.role}</Hand>
        </div>
        {cs.stackLabel && (<div class="meta-item">
          <Mono size={9} as="dt">STACK</Mono>
          <Hand size={17} as="dd" class="meta-value">{cs.stackLabel}</Hand>
        </div>)}
        {cs.time && (<div class="meta-item">
          <Mono size={9} as="dt">TIME</Mono>
          <Hand size={17} as="dd" class="meta-value">{cs.time}</Hand>
        </div>)}
        {cs.status && (<div class="meta-item">
          <Mono size={9} as="dt">STATUS</Mono>
          <Hand size={17} as="dd" class="meta-value">{cs.status}</Hand>
        </div>)}
      </dl>

      {/* ── Links ── */}
      {hasLinks && (
        <div class="links-row" data-reveal>
          <Mono size={9} as="span" class="links-label">LINKS</Mono>
          {p.links.live && (
            <HandLink href={p.links.live} color={NB.redInk} target="_blank" rel="noopener noreferrer">
              <Hand size={18} color={NB.redInk} as="span">live site ↗</Hand>
            </HandLink>
          )}
          {p.links.github && (
            <HandLink href={p.links.github} color={NB.redInk} target="_blank" rel="noopener noreferrer">
              <Hand size={18} color={NB.redInk} as="span">source ↗</Hand>
            </HandLink>
          )}
          {p.links.playStore && (
            <HandLink href={p.links.playStore} color={NB.redInk} target="_blank" rel="noopener noreferrer">
              <Hand size={18} color={NB.redInk} as="span">play store ↗</Hand>
            </HandLink>
          )}
          {p.links.linkedin && (
            <HandLink href={p.links.linkedin} color={NB.redInk} target="_blank" rel="noopener noreferrer">
              <Hand size={18} color={NB.redInk} as="span">write-up ↗</Hand>
            </HandLink>
          )}
        </div>
      )}

      {/* ── Content blocks ── */}
      <div class="content-blocks">

        {/* Overview: yellow sticky */}
        <div class="cs-block" data-reveal>
          <h2 class="cs-label-col">
            <StickyNote color={NB.yellow} rotate={-2} inline={true} class="cs-sticky">
              <Marker size="clamp(19px, 3vw, 28px)">overview</Marker>
            </StickyNote>
          </h2>
          <div class="cs-body-col">
            <Hand size="clamp(17px, 2.8vw, 24px)" color={NB.ink} as="p" class="cs-text">
              {cs.overview}
            </Hand>
          </div>
        </div>

        {/* The problem: pink sticky */}
        <div class="cs-block" data-reveal>
          <h2 class="cs-label-col">
            <StickyNote color={NB.pink} rotate={2} inline={true} class="cs-sticky">
              <Marker size="clamp(19px, 3vw, 28px)">the problem</Marker>
            </StickyNote>
          </h2>
          <div class="cs-body-col">
            <Hand size="clamp(17px, 2.8vw, 24px)" color={NB.ink} as="p" class="cs-text">
              {cs.problem}
            </Hand>
          </div>
        </div>

        {/* Approach: blue sticky + numbered list */}
        <div class="cs-block" data-reveal>
          <h2 class="cs-label-col">
            <StickyNote color={NB.blue} rotate={-1.5} inline={true} class="cs-sticky">
              <Marker size="clamp(19px, 3vw, 28px)">approach</Marker>
            </StickyNote>
          </h2>
          <div class="cs-body-col">
            <ol class="approach-list">
              {cs.approach.map((step) => (
                <li>
                  <Hand size="clamp(17px, 2.8vw, 24px)" color={NB.ink} as="span">
                    {step}
                  </Hand>
                </li>
              ))}
            </ol>
          </div>
        </div>

        {/* What it does: yellow sticky + checklist */}
        {p.features.length > 0 && (
          <div class="cs-block" data-reveal>
            <h2 class="cs-label-col">
              <StickyNote color={NB.yellow} rotate={1.8} inline={true} class="cs-sticky">
                <Marker size="clamp(19px, 3vw, 28px)">what it does</Marker>
              </StickyNote>
            </h2>
            <div class="cs-body-col">
              <ul class="feature-list">
                {p.features.map((f) => (
                  <li>
                    <Mono size={11} color={NB.red} as="span" class="feature-tick">✓</Mono>
                    <Hand size="clamp(17px, 2.8vw, 22px)" color={NB.ink} as="span">
                      {f}
                    </Hand>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        )}

        {/* Outcome: green sticky + stats */}
        <div class="cs-block" data-reveal>
          <h2 class="cs-label-col">
            <StickyNote color={NB.green} rotate={1.5} inline={true} class="cs-sticky">
              <Marker size="clamp(19px, 3vw, 28px)">outcome</Marker>
            </StickyNote>
          </h2>
          <div class="cs-body-col">
            <Hand size="clamp(17px, 2.8vw, 24px)" color={NB.ink} as="p" class="cs-text">
              {cs.outcome}
            </Hand>
            {cs.stats.length > 0 && (
              <div class="stats-row">
                {cs.stats.map((st) => (
                  <div class="stat">
                    <Marker size="clamp(22px, 4vw, 36px)" color={NB.redInk} as="span" class="stat-n">
                      {st.n}
                    </Marker>
                    <Mono size={9} as="span" class="stat-label">{st.label}</Mono>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>

      </div>{/* end .content-blocks */}

      {/* ── Footer nav ── */}
      <nav class="footer-nav" aria-label="Case study navigation" data-reveal>
        <HandLink href="/case-studies/" color={NB.redInk}>
          <Hand size="clamp(17px, 2.8vw, 24px)" color={NB.redInk} as="span">← all case studies</Hand>
        </HandLink>
        <HandLink href={`/case-studies/${nextEntry.id}/`} color={NB.redInk}>
          <Hand size="clamp(17px, 2.8vw, 24px)" color={NB.redInk} as="span">next case study →</Hand>
        </HandLink>
      </nav>

    </article>{/* end .page-body */}
  </GridPaper>
</Base>

<style>
  /* ─────────────── Header ─────────────── */
  .page-header {
    max-width: 1280px;
    margin: 0 auto;
    padding: 16px var(--nb-pad) 14px;
    border-bottom: 1.5px dashed var(--nb-pencil);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }
  .header-left { flex: 1; min-width: 0; }
  .back-link { display: inline-block; }
  .page-title {
    display: block;
    margin: 2px 0 0;
    line-height: 1.05;
  }
  .header-right { padding-bottom: 6px; flex-shrink: 0; }
  .header-tag-desktop { display: none; }
  .header-tag-mobile { display: none; }

  /* ─────────────── Body ─────────────── */
  .page-body {
    padding: 18px var(--nb-pad) 40px;
    max-width: 1280px;
    margin: 0 auto;
  }

  /* ─────────────── Title block ─────────────── */
  .title-block { margin-bottom: 18px; }
  .project-label {
    display: block;
    margin-bottom: 4px;
    color: var(--nb-red, oklch(0.58 0.19 25));
  }
  .project-name {
    display: block;
    line-height: 1.1;
    margin: 0;
    overflow-wrap: anywhere;
  }
  .project-subtitle {
    display: block;
    margin: 12px 0 0;
  }

  /* ─────────────── Hero ─────────────── */
  .hero-wrap {
    margin-top: 18px;
    position: relative;
  }
  /* PhotoCutout with width="100%" needs a block context */
  .hero-wrap :global(.nb-photo) {
    width: 100% !important;
  }

  /* ─────────────── Meta strip ─────────────── */
  .meta-strip {
    margin: 22px 0 0;
    padding: 12px 14px;
    background: var(--nb-paper);
    border: 1.5px solid var(--nb-ink);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px 14px;
  }
  .meta-item { min-width: 0; overflow-wrap: anywhere; }
  .meta-item dt { display: block; }
  .meta-item dd { display: block; margin: 0; }
  .meta-value { display: block; }

  /* ─────────────── Content blocks ─────────────── */
  .content-blocks {
    margin-top: 10px;
  }

  /* Mobile: sticky label stacks above text */
  .cs-block {
    margin-top: 22px;
  }
  .cs-label-col {
    margin: 0 0 10px;
    font-weight: 400;
  }
  .cs-sticky {
    display: inline-block;
    padding: 2px 12px 6px;
  }
  .cs-body-col { min-width: 0; }
  .cs-text {
    margin: 0;
    line-height: 1.45;
  }

  /* ─────────────── Approach list ─────────────── */
  .approach-list {
    margin: 0;
    padding-left: 22px;
    line-height: 1.5;
  }
  .approach-list li { margin-bottom: 4px; }

  /* ─────────────── Feature list ─────────────── */
  .feature-list {
    margin: 0;
    padding: 0;
    list-style: none;
    line-height: 1.5;
  }
  .feature-list li {
    display: flex;
    gap: 8px;
    align-items: baseline;
    margin-bottom: 5px;
  }
  .feature-tick { flex-shrink: 0; }

  /* ─────────────── Links row ─────────────── */
  .links-row {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 18px;
  }
  .links-label {
    color: var(--nb-pencil);
    margin-right: 2px;
  }

  /* ─────────────── Process shots ─────────────── */
  .process-section { margin-top: 22px; }
  .process-heading { margin-bottom: 12px; }
  .process-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  /* PhotoCutout full-width inside grid */
  .process-grid :global(.nb-photo) {
    width: 100% !important;
  }

  /* ─────────────── Stats ─────────────── */
  .stats-row {
    margin-top: 8px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: flex-end;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .stat-n { line-height: 1; }
  .stat-label { display: block; margin-top: 2px; }

  /* ─────────────── Footer nav ─────────────── */
  .footer-nav {
    margin-top: 30px;
    padding: 14px 0;
    border-top: 1.5px dashed var(--nb-pencil);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ─────────────── Desktop (≥880px) ─────────────── */
  @media (min-width: 880px) {
    /* Header */
    .page-header {
      padding: 20px var(--nb-pad) 16px;
      border-bottom-width: 1.8px;
    }
    .header-right { padding-bottom: 10px; }
    .header-tag-mobile { display: none; }
    .header-tag-desktop { display: inline; }

    /* Body */
    .page-body {
      padding-top: 24px;
      padding-bottom: 60px;
    }

    /* Hero taller on desktop */
    .hero-wrap { margin-top: 24px; }
    /* Override PhotoCutout height inline via class trick */
    .hero-wrap :global(.nb-photo) {
      height: 380px !important;
    }

    /* Meta strip: 4 columns on desktop */
    .meta-strip {
      margin-top: 28px;
      padding: 16px 22px;
      border-width: 1.8px;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 14px;
    }
    .meta-item dt { /* Mono size 10 on desktop */ }
    .meta-value { font-size: 22px; }

    /* Content blocks: two-column (label left, text right) */
    .cs-block {
      margin-top: 32px;
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: 30px;
      align-items: flex-start;
    }
    .cs-label-col {
      margin-bottom: 0;
    }
    .cs-sticky {
      padding: 4px 16px 8px;
    }
    .cs-body-col {
      padding-top: 6px;
      max-width: 880px;
    }

    /* Approach list on desktop */
    .approach-list {
      padding-left: 28px;
    }

    /* Process shots: 4 columns on desktop */
    .process-section {
      margin-top: 36px;
    }
    .process-grid {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 18px;
      margin-top: 16px;
    }
    .process-grid :global(.nb-photo) {
      height: 200px !important;
    }

    /* Stats on desktop */
    .stats-row {
      margin-top: 14px;
      gap: 28px;
    }

    /* Footer */
    .footer-nav {
      margin-top: 40px;
      padding-top: 20px;
    }
  }
</style>
