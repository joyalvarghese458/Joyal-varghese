---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import GridPaper from '../components/GridPaper.astro';
import Hand from '../components/Hand.astro';
import HandLink from '../components/HandLink.astro';
import Marker from '../components/Marker.astro';
import Mono from '../components/Mono.astro';
import PhotoCutout from '../components/PhotoCutout.astro';
import { NB } from '../lib/notebook';

const rawItems = await getCollection('gallery');
const items = rawItems.sort((a, b) => a.data.order - b.data.order);

// Split into columns for masonry layout
// Mobile: 2 columns (even index → col 0, odd → col 1)
// Desktop: 4 columns (index % 4)
const col0 = items.filter((_, i) => i % 2 === 0);
const col1 = items.filter((_, i) => i % 2 === 1);

// Desktop 4-col split
const dcols: (typeof items)[] = [[], [], [], []];
items.forEach((it, i) => dcols[i % 4].push(it));

// Ordered list for the preview viewer. The two grids split items across
// columns, so DOM order does not match display order; the viewer navigates
// by this list instead.
const viewerData = items
  .filter((it) => it.data.image)
  .map((it) => ({ src: it.data.image as string, label: it.data.label }));
---

<Base title="Gallery · Joyal Varghese" description="A space for photos, screenshots, and sketches." noindex={items.length === 0}>
  <GridPaper size={22} class="gallery-root">

    {/* ─── Header ─── */}
    <header class="detail-header">
      <div class="detail-header-left">
        <HandLink href="/" color={NB.pencil}>
          <Hand size={18} color={NB.pencil}>← back to home</Hand>
        </HandLink>
        <Marker size="clamp(36px, 7vw, 60px)" as="h1" style="display:block; margin-top:2px;">Gallery.</Marker>
      </div>
      <Mono size={9} class="detail-header-tag">joyal.varghese</Mono>
    </header>

    {/* ─── Content ─── */}
    <div class="gallery-body">
      {rawItems.length === 0 && <Hand size={24} as="p">New photos will appear here.</Hand>}
      <Hand size={19} color={NB.inkSoft} as="p" class="gallery-intro">
        A space for photos, screenshots, and sketches.
      </Hand>

      {/* ─── Mobile grid (2-col) ─── */}
      <div class="gallery-grid-mobile">
        <div class="gallery-col">
          {col0.map((it) => (
            <PhotoCutout
              data-reveal
              data-preview={it.data.image ?? undefined}
              data-label={it.data.label}
              width="100%"
              height={it.data.height ?? 150}
              rotate={it.data.rotate ?? -1.5}
              label={it.data.label}
              src={it.data.image ?? null}
              alt={it.data.label}
            />
          ))}
        </div>
        <div class="gallery-col gallery-col--offset">
          {col1.map((it) => (
            <PhotoCutout
              data-reveal
              data-preview={it.data.image ?? undefined}
              data-label={it.data.label}
              width="100%"
              height={it.data.height ?? 150}
              rotate={it.data.rotate ?? 1.5}
              label={it.data.label}
              src={it.data.image ?? null}
              alt={it.data.label}
            />
          ))}
        </div>
      </div>

      {/* ─── Desktop grid (4-col) ─── */}
      <div class="gallery-grid-desktop">
        {dcols.map((col, ci) => (
          <div class:list={['gallery-dcol', ci % 2 !== 0 ? 'gallery-dcol--offset' : '']}>
            {col.map((it) => (
              <PhotoCutout
                data-reveal
                data-preview={it.data.image ?? undefined}
                data-label={it.data.label}
                width="100%"
                height={it.data.height ?? 180}
                rotate={it.data.rotate ?? (ci % 2 === 0 ? -1.5 : 1.5)}
                label={it.data.label}
                src={it.data.image ?? null}
                alt={it.data.label}
              />
            ))}
          </div>
        ))}
      </div>
    </div>

    {/* ─── Hover preview (pointer devices only) ─── */}
    <div class="gv-hover" id="gvHover" aria-hidden="true">
      <img class="gv-hover-img" alt="" />
    </div>

    {/* ─── Full preview overlay ─── */}
    <div
      class="gv"
      id="gv"
      role="dialog"
      aria-modal="true"
      aria-label="Photo preview"
      hidden
    >
      <button class="gv-close" type="button" data-gv-close aria-label="Close preview">✕</button>
      <button class="gv-nav gv-prev" type="button" data-gv-prev aria-label="Previous photo">←</button>
      <button class="gv-nav gv-next" type="button" data-gv-next aria-label="Next photo">→</button>
      <figure class="gv-figure">
        <img class="gv-img" id="gvImg" alt="" />
        <figcaption class="gv-cap">
          <span id="gvCap"></span>
          <span class="gv-count" id="gvCount"></span>
        </figcaption>
      </figure>
    </div>

    <script type="application/json" id="gvData" set:html={JSON.stringify(viewerData)} />

  </GridPaper>
</Base>

<script>
  // Photo preview: hover popover on pointer devices, tap/click opens the full
  // overlay everywhere. Written to survive ClientRouter navigations: init()
  // re-runs per page, while document-level listeners are bound exactly once.
  type Item = { src: string; label: string };

  interface ViewerState {
    items: Item[];
    byIndex: Map<string, number>;
    gv: HTMLElement | null;
    gvImg: HTMLImageElement | null;
    gvCap: HTMLElement | null;
    gvCount: HTMLElement | null;
    hover: HTMLElement | null;
    hoverImg: HTMLImageElement | null;
    current: number;
    lastTrigger: HTMLElement | null;
    raf: number;
  }

  const S: ViewerState = {
    items: [],
    byIndex: new Map(),
    gv: null,
    gvImg: null,
    gvCap: null,
    gvCount: null,
    hover: null,
    hoverImg: null,
    current: -1,
    lastTrigger: null,
    raf: 0,
  };

  function hideHover() {
    if (!S.hover) return;
    S.hover.classList.remove('is-on');
    // removeAttribute, not src='': an empty src re-requests the page URL
    S.hoverImg?.removeAttribute('src');
  }

  function show(i: number) {
    if (!S.items.length || !S.gvImg) return;
    S.current = (i + S.items.length) % S.items.length;
    const it = S.items[S.current];
    S.gvImg.src = it.src;
    S.gvImg.alt = it.label;
    if (S.gvCap) S.gvCap.textContent = it.label;
    if (S.gvCount) S.gvCount.textContent = `${S.current + 1} / ${S.items.length}`;
  }

  function openViewer(i: number, trigger: HTMLElement | null) {
    if (!S.gv) return;
    S.lastTrigger = trigger;
    hideHover();
    show(i);
    S.gv.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    (S.gv.querySelector('[data-gv-close]') as HTMLElement | null)?.focus();
  }

  function closeViewer() {
    if (!S.gv) return;
    S.gv.hidden = true;
    document.documentElement.style.overflow = '';
    S.lastTrigger?.focus();
    S.lastTrigger = null;
  }

  function positionHover(x: number, y: number) {
    const hover = S.hover;
    if (!hover) return;
    const w = hover.offsetWidth;
    const h = hover.offsetHeight;
    const pad = 14;
    let left = x + 26;
    if (left + w > window.innerWidth - pad) left = x - w - 26; // flip sides
    left = Math.max(pad, Math.min(left, window.innerWidth - w - pad));
    let top = Math.max(pad, Math.min(y - h / 2, window.innerHeight - h - pad));
    hover.style.transform = `translate(${left}px, ${top}px)`;
  }

  function init() {
    // Reset state: the previous page's nodes are gone after a swap.
    S.items = [];
    S.byIndex = new Map();
    S.current = -1;
    S.lastTrigger = null;

    const dataEl = document.getElementById('gvData');
    S.gv = document.getElementById('gv');
    S.gvImg = document.getElementById('gvImg') as HTMLImageElement | null;
    S.gvCap = document.getElementById('gvCap');
    S.gvCount = document.getElementById('gvCount');
    S.hover = document.getElementById('gvHover');
    S.hoverImg = S.hover?.querySelector('.gv-hover-img') as HTMLImageElement | null;

    if (!dataEl || !S.gv || !S.gvImg) return; // not the gallery page

    try {
      S.items = JSON.parse(dataEl.textContent || '[]');
    } catch {
      return;
    }
    if (!S.items.length) return;
    S.byIndex = new Map(S.items.map((it, i) => [it.src, i]));

    S.gv.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === S.gv || t.closest('[data-gv-close]')) return closeViewer();
      if (t.closest('[data-gv-prev]')) return show(S.current - 1);
      if (t.closest('[data-gv-next]')) return show(S.current + 1);
    });

    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    document.querySelectorAll<HTMLElement>('[data-preview]').forEach((el) => {
      const src = el.dataset.preview;
      if (!src) return;
      const idx = S.byIndex.get(src) ?? 0;

      // Added by JS on purpose: without it there is no click affordance.
      el.classList.add('gallery-item');
      el.setAttribute('role', 'button');
      el.setAttribute('tabindex', '0');
      el.setAttribute('aria-label', `View ${el.dataset.label || 'photo'} full size`);

      el.addEventListener('click', () => openViewer(idx, el));
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openViewer(idx, el);
        }
      });

      if (!canHover || !S.hover || !S.hoverImg) return;

      el.addEventListener('mouseenter', (e) => {
        if (!S.gv || !S.gv.hidden || !S.hover || !S.hoverImg) return;
        S.hoverImg.src = src;
        S.hover.classList.add('is-on');
        positionHover(e.clientX, e.clientY);
      });
      el.addEventListener('mousemove', (e) => {
        if (!S.hover?.classList.contains('is-on')) return;
        cancelAnimationFrame(S.raf);
        const { clientX, clientY } = e;
        S.raf = requestAnimationFrame(() => positionHover(clientX, clientY));
      });
      el.addEventListener('mouseleave', hideHover);
    });
  }

  // Bind page-level listeners once per document, not once per navigation.
  const w = window as unknown as { __galleryViewerBound?: boolean };
  if (!w.__galleryViewerBound) {
    w.__galleryViewerBound = true;

    document.addEventListener('keydown', (e) => {
      if (!S.gv || S.gv.hidden) return;
      if (e.key === 'Escape') closeViewer();
      else if (e.key === 'ArrowLeft') show(S.current - 1);
      else if (e.key === 'ArrowRight') show(S.current + 1);
    });

    window.addEventListener('scroll', hideHover, { passive: true });

    // Navigating away with the overlay open must not leave scroll locked.
    document.addEventListener('astro:before-swap', () => {
      document.documentElement.style.overflow = '';
      hideHover();
    });

    // Fires on first load and after every ClientRouter navigation.
    document.addEventListener('astro:page-load', init);
  }
</script>

<style>
  .gallery-root {
    min-height: 100vh;
  }

  /* ─── Header ─── */
  .detail-header {
    padding: 16px 18px 14px;
    border-bottom: 1.5px dashed var(--nb-pencil);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }

  .detail-header-left {
    flex: 1;
  }

  .detail-header-tag {
    padding-bottom: 6px;
  }

  /* ─── Body ─── */
  .gallery-body {
    padding: 16px 18px 60px;
  }

  .gallery-intro {
    display: block;
    margin: 0 0 14px;
  }

  /* ─── Mobile 2-col grid ─── */
  .gallery-grid-mobile {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .gallery-grid-desktop {
    display: none;
  }

  .gallery-col {
    display: grid;
    gap: 12px;
  }

  .gallery-col--offset {
    margin-top: 20px;
  }

  /* ─── Desktop 4-col grid ─── */
  @media (min-width: 880px) {
    .detail-header {
      padding: 20px 60px 16px;
      border-bottom-width: 1.8px;
    }

    .detail-header-tag {
      padding-bottom: 10px;
    }

    .gallery-body {
      padding: 20px 60px 60px;
    }

    .gallery-intro {
      font-size: 24px;
      margin-bottom: 22px;
    }

    /* Hide mobile grid, show desktop */
    .gallery-grid-mobile {
      display: none;
    }

    .gallery-grid-desktop {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .gallery-dcol {
      display: grid;
      gap: 18px;
    }

    .gallery-dcol--offset {
      margin-top: 22px;
    }
  }

  /* ─────────────── Clickable photo ─────────────── */
  .gallery-item {
    cursor: pointer;
    outline-offset: 4px;
  }
  .gallery-item:focus-visible {
    outline: 2.5px solid var(--nb-ink);
  }
  @media (hover: hover) and (pointer: fine) {
    .gallery-item {
      transition: transform 0.16s ease;
    }
    .gallery-item:hover {
      /* nudge, without fighting the per-photo rotate() on the same element */
      filter: brightness(1.04);
    }
  }

  /* ─────────────── Hover preview ─────────────── */
  .gv-hover {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 90;
    padding: 7px 7px 26px;
    background: #fff;
    border: 1.5px solid var(--nb-ink);
    box-shadow: 5px 6px 0 rgba(0, 0, 0, 0.16);
    transform: translate(-9999px, -9999px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.13s ease;
    pointer-events: none;
    rotate: -1.2deg;
  }
  .gv-hover.is-on {
    opacity: 1;
    visibility: visible;
  }
  .gv-hover-img {
    display: block;
    max-width: 340px;
    max-height: 62vh;
    width: auto;
    height: auto;
  }
  /* No hover preview on touch; the tap opens the full overlay instead. */
  @media (hover: none), (pointer: coarse) {
    .gv-hover { display: none; }
  }

  /* ─────────────── Full preview overlay ─────────────── */
  .gv {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(26, 26, 26, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    /* bottom room for the mobile nav row */
    padding: 16px 16px 72px;
  }
  .gv[hidden] { display: none; }

  .gv-figure {
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  /* Sized against the viewport, not the parent: the figure's own width comes
     from this image, so a percentage max-width here resolves circularly and
     the image overflows. */
  .gv-img {
    display: block;
    max-width: calc(100vw - 32px);
    max-height: calc(100vh - 140px);
    width: auto;
    height: auto;
    background: #fff;
    padding: 6px;
    border: 1.5px solid #fff;
  }
  .gv-cap {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.5px;
    color: rgba(255, 255, 255, 0.82);
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .gv-count { color: rgba(255, 255, 255, 0.5); }

  .gv-close,
  .gv-nav {
    position: absolute;
    background: var(--nb-paper);
    border: 1.5px solid var(--nb-ink);
    color: var(--nb-ink);
    font-family: "JetBrains Mono", monospace;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    line-height: 1;
  }
  .gv-close {
    top: 14px;
    right: 14px;
    width: 40px;
    height: 40px;
    font-size: 15px;
    border-radius: 50%;
  }
  /* Mobile: nav sits in a bottom row so it never covers the photo. */
  .gv-nav {
    bottom: 16px;
    width: 42px;
    height: 42px;
    font-size: 17px;
    border-radius: 50%;
  }
  .gv-prev { left: 16px; }
  .gv-next { right: 16px; }

  .gv-close:focus-visible,
  .gv-nav:focus-visible {
    outline: 2.5px solid var(--nb-yellow, #ffe45c);
    outline-offset: 2px;
  }

  /* Desktop: arrows return to the vertical centre, in gutters beside the photo. */
  @media (min-width: 880px) {
    .gv { padding: 16px; }
    .gv-nav {
      top: 50%;
      bottom: auto;
      transform: translateY(-50%);
    }
    .gv-prev { left: 26px; }
    .gv-next { right: 26px; }
    .gv-close { top: 20px; right: 22px; }
    .gv-img {
      max-width: calc(100vw - 160px);
      max-height: calc(100vh - 110px);
    }
  }
</style>
