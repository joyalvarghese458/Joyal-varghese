---
import { getCollection } from 'astro:content';
import { getBlogPosts } from '../lib/blog';
import Base from '../layouts/Base.astro';
import GridPaper from '../components/GridPaper.astro';
import StickyNote from '../components/StickyNote.astro';
import Highlight from '../components/Highlight.astro';
import HandUnderline from '../components/HandUnderline.astro';
import HandArrow from '../components/HandArrow.astro';
import HandBox from '../components/HandBox.astro';
import PhotoCutout from '../components/PhotoCutout.astro';
import Marker from '../components/Marker.astro';
import Hand from '../components/Hand.astro';
import Mono from '../components/Mono.astro';
import Doodle from '../components/Doodle.astro';
import HandLink from '../components/HandLink.astro';
import ProjectLogo from '../components/ProjectLogo.astro';
import { NB, swatch } from '../lib/notebook';

// ── Content ────────────────────────────────────────────────────────────────
const profileEntries = await getCollection('profile');
const profile = profileEntries[0].data;

const allExperience = (await getCollection('experience'))
  .sort((a, b) => a.data.order - b.data.order);

const allEducation = (await getCollection('education'))
  .sort((a, b) => a.data.order - b.data.order);

const allSkills = (await getCollection('skills'))
  .sort((a, b) => a.data.order - b.data.order);

const allProjects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);

const featuredProjects = allProjects.filter((p) => p.data.featured).length > 0
  ? allProjects.filter((p) => p.data.featured)
  : allProjects.slice(0, 3);

const allGallery = (await getCollection('gallery'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const allBlogLinks = (await getBlogPosts())
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 4);

// Tag pill rotations
const tagRots = [-2, 1, -1, 2, -1.5, 0.8, -0.6, 1.2, -0.9, 1.5];

// Gallery photo rotations
const galleryRots = [-2, 1.5, -1, 2.5];

// Format blog date as "MAY 12" etc.
function formatBlogDate(iso: string): string {
  const d = new Date(iso);
  const months = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
  return `${months[d.getMonth()]} ${d.getDate()}`;
}
---

<Base
  title={`${profile.name} | Full Stack Software Developer in UAE`}
  description="Joyal Varghese is a full stack software developer in Sharjah, UAE, building React, Next.js and NestJS applications, ERP systems and business tools."
>
  <GridPaper size={22} class="home-paper">

    {/* Torn-paper top edge accent */}
    <div class="torn-top" aria-hidden="true"></div>

    {/* ── Desktop top nav (hidden on mobile) ── */}
    <nav class="top-nav" aria-label="Site navigation">
      <Mono size={11} as="span">// portfolio.2026 · joyal.varghese</Mono>
      <div class="top-nav-links">
        <HandLink href="/projects"><Hand size={22}>work</Hand></HandLink>
        {allGallery.length > 0 && (<HandLink href="/gallery"><Hand size={22}>gallery</Hand></HandLink>)}
        {allBlogLinks.length > 0 && (<HandLink href="/blog"><Hand size={22}>writing</Hand></HandLink>)}
        <HandLink href="#contact"><Hand size={22}>contact</Hand></HandLink>
      </div>
    </nav>

    {/* ════════════════════════════════════════
        HERO
    ════════════════════════════════════════ */}
    <section class="hero-section">
      {/* Mobile mono label */}
      <Mono size={9} as="div" class="hero-mono-label">// portfolio.2026 · joyal.varghese</Mono>

      <div class="hero-inner">
        {/* Photo: first in source so the mobile float wraps text around it.
            Desktop column order is pinned via grid-column, not source order. */}
        <div class="hero-photo-wrap">
          <div class="hero-photo-inner">
            {/* Washi tape strips */}
            <div class="washi washi-top" aria-hidden="true"></div>
            <div class="washi washi-bottom" aria-hidden="true"></div>
            <PhotoCutout
              width="clamp(116px, 33vw, 280px)"
              height="clamp(141px, 40vw, 340px)"
              rotate={-3}
              label={profile.photoCaption}
              src={profile.photo ?? undefined}
              alt={`Photo of ${profile.firstName}`}
            />
          </div>
          {/* Desktop caption doodle */}
          <div class="photo-caption-wrap" aria-hidden="true">
            <HandArrow direction="up-left" length={80} />
            <Hand size={22} color={NB.inkSoft} class="photo-caption-text">{profile.photoCaption}</Hand>
          </div>
        </div>

        {/* Text */}
        <div class="hero-text">
          <div class="hero-greeting">
            <Marker size={"clamp(44px, 8vw, 72px)"}>{profile.greeting}</Marker>
          </div>
          <div class="hero-name-line">
          <Marker
            size="min(132px, 11.5cqw)"
            color={NB.redInk}
            as="h1"
            class="hero-firstname"
            style="display: block;"
          >{profile.name}</Marker>
          </div>

          <div class="hero-tagline">
            <Hand size={"clamp(22px, 3.5vw, 36px)"} as="div" style="display: block; margin-top: 4px;">
              {profile.tagline.map((seg) =>
                seg.highlight
                  ? <Highlight color={swatch(seg.highlight)} height="0.65em">{seg.text}</Highlight>
                  : <span>{seg.text}</span>
              )}
            </Hand>
          </div>

          {/* Tag pills */}
          <a class="resume-link" href="/Joyal_Varghese_Resume.pdf" download data-astro-reload>Download resume ↗</a>

          <div class="hero-tags">
            {profile.tags.map((tag, i) => (
              <span
                class="tag-pill"
                style={`transform: rotate(${tagRots[i % tagRots.length]}deg);`}
              >· {tag} ·</span>
            ))}
          </div>

          {/* Desktop-only status dot */}
          <div class="hero-status">
            <Mono size={10} as="span">STATUS</Mono>
            <Hand size={22} as="span" style={`margin-left: 8px;`}>
              · <Highlight color={NB.green}>{profile.status}</Highlight>
            </Hand>
            <span class="status-dot" aria-hidden="true"></span>
          </div>
        </div>

      </div>
    </section>

    {/* ════════════════════════════════════════
        BIO
    ════════════════════════════════════════ */}
    <section class="section bio-section" data-reveal>
      <div class="section-title">
        <StickyNote color={NB.yellow} rotate={-3} inline>
          <Marker size={"clamp(26px, 3vw, 34px)"}>Personal Bio</Marker>
        </StickyNote>
      </div>
      <div class="bio-body">
        <Hand size={"clamp(20px, 2.2vw, 26px)"} color={NB.ink} as="p" class="bio-text">
          {profile.bio}
        </Hand>
        <HandUnderline width={120} class="bio-underline" />
      </div>
    </section>

    {/* ════════════════════════════════════════
        EXPERIENCE + EDUCATION/SKILLS (2-col on desktop)
    ════════════════════════════════════════ */}
    <div class="exp-edu-grid section" data-reveal>

      {/* Experience */}
      <div class="exp-col">
        <div class="section-title">
          <StickyNote color={NB.yellow} rotate={2} inline>
            <Marker size={"clamp(26px, 3vw, 34px)"}>Experience</Marker>
          </StickyNote>
        </div>
        <div class="exp-rows">
          {allExperience.map((entry) => (
            <div class="exp-row">
              <Mono size={9} as="div" class="exp-year">{entry.data.year}</Mono>
              <div class="exp-body">
                <Hand size={"clamp(20px, 2vw, 26px)"} weight={600} as="div" class="exp-role">{entry.data.role}</Hand>
                {entry.data.url ? (
                  <HandLink
                    href={entry.data.url}
                    color={NB.pencil}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="exp-place-link"
                  >
                    <Hand size={"clamp(15px, 1.5vw, 18px)"} color={NB.pencil} as="span" class="exp-place">{entry.data.place}</Hand>
                  </HandLink>
                ) : (
                  <Hand size={"clamp(15px, 1.5vw, 18px)"} color={NB.pencil} as="div" class="exp-place">{entry.data.place}</Hand>
                )}
                <Hand size={"clamp(15px, 1.5vw, 18px)"} color={NB.inkSoft} as="div" class="exp-desc">{entry.data.desc}</Hand>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Education + Skills */}
      <div class="edu-skills-col">
        {/* Education */}
        <div class="edu-block">
        <div class="section-title">
          <StickyNote color={NB.yellow} rotate={-2} inline>
            <Marker size={"clamp(26px, 3vw, 34px)"}>Education</Marker>
          </StickyNote>
        </div>
        <div class="exp-rows">
          {allEducation.map((entry) => (
            <div class="exp-row">
              <Mono size={9} as="div" class="exp-year">{entry.data.year}</Mono>
              <div class="exp-body">
                <Hand size={"clamp(20px, 2vw, 26px)"} weight={600} as="div" class="exp-role">{entry.data.role}</Hand>
                <Hand size={"clamp(15px, 1.5vw, 18px)"} color={NB.pencil} as="div" class="exp-place">{entry.data.place}</Hand>
                <Hand size={"clamp(15px, 1.5vw, 18px)"} color={NB.inkSoft} as="div" class="exp-desc">{entry.data.desc}</Hand>
              </div>
            </div>
          ))}
        </div>
        </div>

        {/* Good At */}
        <div class="skills-wrap">
          <div class="section-title">
            <StickyNote color={NB.yellow} rotate={3} inline>
              <Marker size={"clamp(26px, 3vw, 34px)"}>Good At</Marker>
            </StickyNote>
          </div>
          <ul class="skills-list">
            {allSkills.map((skill) => (
              <li class="skill-item">
                <Doodle kind="check" size={16} color={NB.red} class="skill-check" />
                <div class="skill-chips">
                  {skill.data.label.split(',').map((part) => (
                    <span class="skill-chip">
                      <Hand size={"clamp(15px, 1.5vw, 18px)"}>{part.trim()}</Hand>
                    </span>
                  ))}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>

    </div>

    {/* ════════════════════════════════════════
        FEATURED WORK
    ════════════════════════════════════════ */}
    <section class="section featured-section" data-reveal>
      <div class="section-title">
        <StickyNote color={NB.yellow} rotate={-1.5} inline>
          <Marker size={"clamp(26px, 3vw, 34px)"}>Featured Work</Marker>
        </StickyNote>
      </div>
      <div class="project-grid">
        {featuredProjects.map((project) => (
          <a href={`/projects/${project.id}`} class="project-card-link">
            <div class="project-card">
              <HandBox rounded width={380} height={156} />
              <div class="project-card-content">
                <div class="project-card-header">
                  <ProjectLogo
                    color={swatch(project.data.logoColor)}
                    letter={project.data.title[0]}
                    size={44}
                    rot={-4}
                    class="project-logo"
                  />
                  <div class="project-card-meta">
                    <Mono size={9} as="div">{project.data.tag}</Mono>
                    <Hand size={"clamp(20px, 2.5vw, 28px)"} weight={600} as="div" class="project-title">{project.data.title}</Hand>
                  </div>
                </div>
                <Hand size={"clamp(17px, 1.8vw, 20px)"} color={NB.inkSoft} as="div" class="project-desc">{project.data.summary}</Hand>
              </div>
            </div>
          </a>
        ))}
      </div>
      <div class="see-all">
        <HandLink href="/projects" color={NB.redInk}>
          <Hand size={"clamp(20px, 2vw, 24px)"} color={NB.redInk}>see all projects →</Hand>
        </HandLink>
      </div>
    </section>

    {/* ════════════════════════════════════════
        GALLERY PREVIEW
    ════════════════════════════════════════ */}
    {allGallery.length > 0 && (<section class="section gallery-section" data-reveal>
      <div class="section-title">
        <StickyNote color={NB.yellow} rotate={2} inline>
          <Marker size={"clamp(26px, 3vw, 34px)"}>Gallery</Marker>
        </StickyNote>
      </div>
      <div class="gallery-grid">
        {allGallery.map((item, i) => (
          <PhotoCutout
            width="100%"
            height={item.data.height ?? (i % 2 === 0 ? 110 : 140)}
            rotate={item.data.rotate ?? galleryRots[i % galleryRots.length]}
            label={item.data.label}
            src={item.data.image ?? undefined}
            alt={item.data.label}
          />
        ))}
      </div>
      <div class="see-all">
        <HandLink href="/gallery" color={NB.redInk}>
          <Hand size={"clamp(20px, 2vw, 24px)"} color={NB.redInk}>open gallery →</Hand>
        </HandLink>
      </div>
    </section>)}

    {/* ════════════════════════════════════════
        MINI BLOG
    ════════════════════════════════════════ */}
    {allBlogLinks.length > 0 && (<section class="section blog-section" data-reveal>
      <div class="section-title">
        <StickyNote color={NB.yellow} rotate={-3} inline>
          <Marker size={"clamp(26px, 3vw, 34px)"}>Mini Blog</Marker>
        </StickyNote>
      </div>
      <div class="blog-list">
        {allBlogLinks.map((post) => (
          <div class="blog-row">
            <Mono size={9} as="div" class="blog-date">{formatBlogDate(post.data.date)}</Mono>
            <HandLink
              href={post.data.url}
              target={post.data.url.startsWith('/') ? undefined : '_blank'}
              rel={post.data.url.startsWith('/') ? undefined : 'noopener noreferrer'}
              class="blog-link"
            >
              <Hand size={"clamp(19px, 2vw, 23px)"}>{post.data.title}</Hand>
            </HandLink>
          </div>
        ))}
      </div>
      <div class="see-all">
        <HandLink href="/blog" color={NB.redInk}>
          <Hand size={"clamp(20px, 2vw, 24px)"} color={NB.redInk}>all posts →</Hand>
        </HandLink>
      </div>
    </section>)}

    {/* ════════════════════════════════════════
        CONTACT + FOOTER
    ════════════════════════════════════════ */}
    <section id="contact" class="section contact-section" data-reveal>
      <div class="contact-heading-row">
        <Marker size={"clamp(32px, 5vw, 48px)"}>Say hi.</Marker>
        <HandArrow
          direction="down-right"
          length={50}
          class="contact-arrow"
        />
      </div>
      <Hand size={"clamp(20px, 2.2vw, 26px)"} color={NB.inkSoft} as="p" class="contact-subline">
        I'm always up for a chat about code, the web, or weird projects.
      </Hand>

      <div class="contact-grid">
        {profile.contacts.map((contact) => (
          <a href={contact.url} target="_blank" rel="noopener noreferrer" class="contact-sticky-link">
            <StickyNote color={swatch(contact.color)} rotate={contact.color === 'yellow' ? -3 : contact.color === 'pink' ? 2 : contact.color === 'blue' ? 1.5 : -2} class="contact-sticky">
              <div class="contact-sticky-inner">
                <span class="contact-icon" aria-hidden="true">
                  {contact.sub === 'whatsapp' ? (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M20.52 3.48A11.9 11.9 0 0 0 12.05 0C5.46 0 .1 5.36.1 11.95c0 2.1.55 4.16 1.6 5.98L0 24l6.25-1.64a11.95 11.95 0 0 0 5.8 1.48h.01C18.65 23.84 24 18.48 24 11.9c0-3.19-1.24-6.18-3.48-8.42ZM12.06 21.82h-.01a9.9 9.9 0 0 1-5.05-1.38l-.36-.22-3.71.97.99-3.62-.24-.37a9.91 9.91 0 0 1-1.52-5.25c0-5.48 4.46-9.94 9.95-9.94a9.87 9.87 0 0 1 7.03 2.91 9.87 9.87 0 0 1 2.91 7.03c0 5.48-4.46 9.87-9.99 9.87Zm5.45-7.44c-.3-.15-1.77-.87-2.04-.97-.28-.1-.48-.15-.68.15s-.77.97-.95 1.17c-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.18-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.09 4.49.71.31 1.27.49 1.7.63.71.23 1.36.2 1.87.12.57-.08 1.77-.72 2.02-1.42.25-.69.25-1.29.17-1.42-.07-.12-.27-.2-.57-.34Z" />
                    </svg>
                  ) : contact.sub === 'instagram' ? (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="3" width="18" height="18" rx="5" />
                      <circle cx="12" cy="12" r="4" />
                      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                    </svg>
                  ) : contact.icon}
                </span>
                <div class:list={['contact-text', { 'contact-text-email': contact.sub === 'email' }]}>
                  <Mono size={9} as="div">{contact.sub}</Mono>
                  <Hand size={contact.sub === 'email' ? 'min(20px, 7cqi)' : 'clamp(17px, 1.8vw, 20px)'} as="div">{contact.label}</Hand>
                </div>
              </div>
            </StickyNote>
          </a>
        ))}
      </div>

      {/* Footer */}
      <footer class="footer">
        <Mono size={9} as="span" class="footer-left">{profile.footerNote}</Mono>
        <Hand size={22} color={NB.pencil} as="span" class="footer-right">end of page ✦</Hand>
      </footer>
    </section>

  </GridPaper>
</Base>

<style>
.resume-link { display: inline-block; margin-top: 18px; padding: 8px 14px; background: var(--nb-yellow, #ffe45c); border: 1.5px solid currentColor; border-radius: 5px; color: #1a1a1a; font-family: "JetBrains Mono", monospace; font-size: 12px; text-decoration: none; }
.resume-link:hover { transform: rotate(-1deg); }
.resume-link:focus-visible { outline: 3px solid #1a1a1a; outline-offset: 4px; }
/* ────────────────────────────────────────────────────────────────────────────
   PAGE SHELL
──────────────────────────────────────────────────────────────────────────── */
.home-paper {
  max-width: 1280px;
  margin: 0 auto;
  min-height: 100vh;
  /* `clip` (not `hidden`): `hidden` would force overflow-y:auto and turn
     this into a nested scroll container, producing a second scrollbar. */
  overflow-x: clip;
}

/* Torn-paper top-edge accent */
.torn-top {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4px;
  background: repeating-linear-gradient(
    90deg,
    transparent 0 8px,
    rgba(0, 0, 0, 0.04) 8px 10px
  );
  pointer-events: none;
}

/* ────────────────────────────────────────────────────────────────────────────
   TOP NAV: desktop only
──────────────────────────────────────────────────────────────────────────── */
.top-nav {
  display: none;
}

@media (min-width: 880px) {
  .top-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px var(--nb-pad) 0;
  }
}

.top-nav-links {
  display: flex;
  gap: 24px;
  align-items: center;
}

/* ────────────────────────────────────────────────────────────────────────────
   SHARED SECTION WRAPPER
──────────────────────────────────────────────────────────────────────────── */
.section {
  padding: 28px var(--nb-pad) 0;
  position: relative;
}

.section-title {
  display: inline-block;
  margin-bottom: 14px;
}

/* ────────────────────────────────────────────────────────────────────────────
   HERO
──────────────────────────────────────────────────────────────────────────── */
.hero-section {
  padding: 28px var(--nb-pad) 0;
  position: relative;
}

.hero-mono-label {
  display: block;
  margin-bottom: 10px;
}

@media (min-width: 880px) {
  .hero-mono-label {
    display: none;
  }
}

/* Mobile: block flow with the photo floated right, so the tagline and tag
   pills wrap beside it and then reclaim the full width underneath, no dead
   column of space below the photo. */
.hero-inner {
  display: block;
}

/* Contain the float so it can't bleed into the bio section below. */
.hero-inner::after {
  content: "";
  display: block;
  clear: both;
}

@media (min-width: 880px) {
  .hero-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 40px;
    padding-top: 12px;
  }
  /* Photo is first in source order for the mobile float; put the columns
     back in visual order here. ::after is not generated in grid. */
  .hero-text { grid-column: 1; grid-row: 1; }
  .hero-photo-wrap { grid-column: 2; grid-row: 1; }
  .hero-inner::after { content: none; }
}

/* Hero text */
.hero-text {
  min-width: 0;
}

.hero-name-line {
  display: flow-root;
  container-type: inline-size;
}

@media (max-width: 600px) {
  .hero-inner {
    display: flex;
    flex-direction: column;
  }
  .hero-text { order: -1; }
  .hero-inner .hero-photo-wrap {
    float: none;
    align-self: center;
    margin: 28px 0 16px;
  }
  .hero-inner .hero-photo-inner { width: min(220px, 65vw); }
  .hero-photo-inner :global(.nb-photo) {
    width: 100% !important;
    height: min(270px, 80vw) !important;
  }
}

.hero-firstname {
  display: block;
  white-space: nowrap;
  margin: 4px 0 12px;
  line-height: 1;
}

@media (min-width: 880px) {
  .hero-firstname {
    margin-top: 4px;
  }
}

.hero-tagline {
  margin-top: 4px;
}

/* Tag pills: inline-block rather than flex on purpose: inline content wraps
   around the floated photo, flex items do not (they would overlap it). */
.hero-tags {
  margin-top: 16px;
  margin-bottom: -8px; /* absorb the last row's pill margin */
  max-width: 540px;
  line-height: 0; /* kill inline-block baseline gaps */
}

@media (min-width: 880px) {
  .hero-tags {
    margin-top: 22px;
  }
}

.tag-pill {
  font-family: "Kalam", cursive;
  font-size: clamp(17px, 2vw, 22px);
  line-height: 1.5;
  padding: clamp(1px, 0.3vw, 2px) clamp(8px, 1.2vw, 14px);
  border: 1.5px solid var(--nb-ink);
  border-radius: 999px;
  background: var(--nb-paper);
  display: inline-block;
  margin: 0 8px 8px 0;
}

@media (min-width: 880px) {
  .tag-pill {
    margin: 0 10px 10px 0;
  }
}

/* Status dot: desktop only */
.hero-status {
  display: none;
}

@media (min-width: 880px) {
  .hero-status {
    display: flex;
    align-items: center;
    margin-top: 26px;
    gap: 4px;
  }
}

.status-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #3eb058;
  box-shadow: 0 0 0 4px rgba(62, 176, 88, 0.18);
