---
import { NB } from '../lib/notebook';

interface Props {
  width?: number | string;
  height?: number | string;
  color?: string;
  strokeWidth?: number;
  rounded?: boolean;
  dashed?: boolean;
  class?: string;
  [key: string]: unknown;
}

const cssSize = (v: string | number) => typeof v === 'number' ? v + 'px' : v;

const {
  width = 200,
  height = 100,
  color = NB.ink,
  strokeWidth = 2,
  rounded = false,
  dashed = false,
  class: className,
  ...rest
} = Astro.props;

// For viewBox and path math, we need numeric values
const w = typeof width === 'number' ? width : 200;
const h = typeof height === 'number' ? height : 100;
const r = rounded ? 12 : 0;

const path = rounded
  ? `M${r + 3},2 L${w - r - 2},3 Q${w - 1},4 ${w - 2},${r + 3} L${w - 3},${h - r - 2} Q${w - 2},${h - 1} ${w - r - 3},${h - 2} L${r + 2},${h - 3} Q1,${h - 2} 3,${h - r - 2} L2,${r + 3} Q3,2 ${r + 3},2 Z`
  : `M3,2 L${w - 2},3 L${w - 3},${h - 2} L2,${h - 3} Z`;
---

<svg
  aria-hidden="true"
  focusable="false"
  viewBox={`0 0 ${w} ${h}`}
  width="100%"
  height="100%"
  class={className}
  style="position: absolute; inset: 0; width: 100%; height: 100%; display: block; overflow: visible; pointer-events: none;"
  preserveAspectRatio="none"
  {...rest}
>
  <path
    d={path}
    fill="none"
    stroke={color}
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-dasharray={dashed ? '6 4' : 'none'}
  />
</svg>
