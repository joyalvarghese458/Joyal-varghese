---
import { NB } from '../lib/notebook';

interface Props {
  color?: string;
  rotate?: number;
  peel?: boolean;
  inline?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { color = NB.yellow, rotate = -2, peel = true, inline = false, class: className, ...rest } = Astro.props;
const Tag = inline ? 'span' : 'div';

const cls = [
  'nb-sticky',
  peel ? 'nb-sticky-peel' : '',
  className ?? '',
].filter(Boolean).join(' ');
---

<Tag
  class={cls}
  style={`background: ${color}; transform: rotate(${rotate}deg); display: ${inline ? 'inline-block' : 'block'};`}
  {...rest}
>
  <Tag class="nb-sticky-inner"><slot /></Tag>
</Tag>
