---
import { navigation } from '../lib/navigation';
import profile from '../content/profile/main.json';
---
<footer class="site-footer">
  <div class="footer-top">
    <p>Joyal Varghese <span>Software developer · Sharjah, UAE</span></p>
    <a class="nb-link next-page" href="/contact/">Have something in mind? Say hi →</a>
  </div>
  <nav aria-label="Footer navigation">
    {navigation.map(({ href, label }) => <a href={href}>{label}</a>)}
  </nav>
  <div class="footer-bottom"><small>{profile.footerNote}</small><span>end of page ✦</span></div>
</footer>
<style>
  .site-footer { margin: 0 var(--nb-pad); padding: 30px 0 26px; border-top: 1.5px dashed var(--nb-pencil); }
  .footer-top p { margin: 0 0 16px; font-size: 23px; line-height: 1.3; }
  .footer-top p span { display: block; color: var(--nb-pencil); font-size: 17px; }
  .next-page { display: inline-block; font-size: 21px; padding: 8px 0; }
  nav { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px 16px; margin: 26px 0 28px; }
  nav a { min-height: 44px; padding: 9px 0; font-size: 18px; text-underline-offset: 5px; }
  .footer-bottom { display: grid; gap: 10px; color: var(--nb-pencil); }
  small { display: block; font: 10px/1.8 'JetBrains Mono', monospace; max-width: 65ch; }
  .footer-bottom span { font-size: 16px; text-align: center; }
  @media (min-width: 880px) {
    .footer-top { display: flex; justify-content: space-between; gap: 24px; align-items: center; }
    nav { display: flex; flex-wrap: wrap; gap: 0 22px; margin: 12px 0 20px; }
    .footer-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
    .footer-bottom span { text-align: initial; }
  }
</style>
