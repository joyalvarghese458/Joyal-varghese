---
import profile from '../content/profile/main.json';
import fullStack from '../content/education/01-full-stack.json';
import degree from '../content/education/02-computer-science.json';
import higherSecondary from '../content/education/03-higher-secondary.json';
import botProfile from '../data/bot-profile.json';

const contact = profile.contacts.find((item) => item.sub === 'email');
---

<aside class="about-bot" data-about-bot aria-label="Ask about Joyal">
  <button class="about-bot__launcher" type="button" aria-label="Open About Me chat" aria-expanded="false" aria-controls="about-bot-panel">
    <span class="about-bot__robot" aria-hidden="true">
      <svg viewBox="0 0 64 64" role="presentation" focusable="false">
        <defs>
          <linearGradient id="bot-shell" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#dff1ff" />
            <stop offset="1" stop-color="#8ebce5" />
          </linearGradient>
          <linearGradient id="bot-screen" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#173246" />
            <stop offset="1" stop-color="#071b2b" />
          </linearGradient>
          <linearGradient id="bot-body" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffd9e1" />
            <stop offset="1" stop-color="#e99db5" />
          </linearGradient>
          <filter id="bot-shadow" x="-30%" y="-30%" width="160%" height="180%">
            <feDropShadow dx="0" dy="2" stdDeviation="1.8" flood-color="#8290a5" flood-opacity=".35" />
          </filter>
        </defs>
        <ellipse cx="32" cy="60" rx="13" ry="2" fill="#9ba5b5" opacity=".22" />
        <g filter="url(#bot-shadow)">
          <path d="M14 35c-5 2-6 9-7 14-.5 3 1 5 3 5 3 0 5-5 6-10l3-8z" fill="url(#bot-shell)" />
          <path d="M50 35c5 2 6 9 7 14 .5 3-1 5-3 5-3 0-5-5-6-10l-3-8z" fill="url(#bot-shell)" />
          <rect x="27" y="3" width="10" height="8" rx="4" fill="url(#bot-shell)" />
          <circle cx="32" cy="3" r="1.5" fill="#59dce6" />
          <path d="M32 4v-1" stroke="#8b96a8" stroke-width="1" />
          <rect x="9" y="9" width="46" height="29" rx="13" fill="url(#bot-shell)" stroke="#43627f" stroke-width="1" />
          <rect x="14" y="14" width="36" height="20" rx="8" fill="url(#bot-screen)" />
          <path d="M18 16c5-3 20-3 27-1" fill="none" stroke="#fff" stroke-width="2" opacity=".55" stroke-linecap="round" />
          <path d="M19 24c0-3 2-4 4-4s4 1 4 4c-2 1-6 1-8 0zm18 0c0-3 2-4 4-4s4 1 4 4c-2 1-6 1-8 0z" fill="#63e4eb" />
          <path d="M28 28c2 2 6 2 8 0 0 4-8 4-8 0z" fill="#63e4eb" />
          <rect x="22" y="37" width="20" height="19" rx="9" fill="url(#bot-body)" stroke="#9d506d" stroke-width=".8" />
          <path d="M22 43c5 3 15 3 20 0v8c-5 4-15 4-20 0z" fill="#db7898" opacity=".7" />
        </g>
      </svg>
    </span>
  </button>

  <section class="about-bot__panel" id="about-bot-panel" hidden>
    <div class="about-bot__head">
      <div>
        <p class="about-bot__eyebrow">Joyal's little helper</p>
        <h2>Ask me anything</h2>
      </div>
      <button class="about-bot__close" type="button" aria-label="Close chat">×</button>
    </div>
    <div class="about-bot__messages" aria-live="polite">
      <div class="about-bot__message about-bot__message--bot">Hi! I can tell you about Joyal's work, skills, projects, or how to get in touch.</div>
    </div>
    <div class="about-bot__prompts" aria-label="Suggested questions">
      <button type="button" data-question="Who is Joyal?">Who is Joyal?</button>
      <button type="button" data-question="What does Joyal build?">What does he build?</button>
      <button type="button" data-question="How can I contact Joyal?">Contact details</button>
    </div>
    <form class="about-bot__form">
      <label class="sr-only" for="about-bot-input">Ask a question about Joyal</label>
      <input id="about-bot-input" name="question" autocomplete="off" placeholder="Ask a question about Joyal" />
      <button type="submit" aria-label="Send question">↗</button>
    </form>
  </section>
</aside>

<script define:vars={{ bio: profile.bio, email: contact?.label ?? '', phone: profile.contacts.find((item) => item.sub === 'phone')?.label ?? '', resume: '/Joyal_Varghese_Resume.pdf', education: { fullStack, degree, higherSecondary }, personal: botProfile }}>
  const root = document.querySelector('[data-about-bot]');
  if (root && !root.dataset.ready) {
    root.dataset.ready = 'true';
    const launcher = root.querySelector('.about-bot__launcher');
    const panel = root.querySelector('.about-bot__panel');
    const close = root.querySelector('.about-bot__close');
    const form = root.querySelector('.about-bot__form');
    const input = root.querySelector('input');
    const messages = root.querySelector('.about-bot__messages');
    const answer = (question) => {
      const q = question.toLowerCase();
      if (q.includes('phone') || q.includes('mobile') || q.includes('number') || q.includes('call')) return `Joyal's phone number is <a href="tel:${phone.replace(/\s/g, '')}">${phone}</a>.`;
      if (q.includes('contact') || q.includes('email') || q.includes('hire')) return `You can reach Joyal at <a href="mailto:${email}">${email}</a>, or use the contact page.`;
      if (q.includes('father') || q.includes('dad')) return `Joyal's father's name is ${personal.family.father} 👨.`;
      if (q.includes('mother') || q.includes('mom') || q.includes('mum')) return `Joyal's mother's name is ${personal.family.mother} 👩.`;
      if (q.includes('sister')) return `Joyal's sister is ${personal.family.sister} 👧.`;
      if (q.includes('girlfriend') || q.includes('relationship')) return personal.family.girlfriend;
      if (q.includes('family') || q.includes('parents') || q.includes('home')) return `${personal.background} His family includes his father, ${personal.family.father}; mother, ${personal.family.mother}; and sister, ${personal.family.sister}. Girlfriend status: ${personal.family.girlfriend}`;
      if (q.includes('age') || q.includes('old') || q.includes('birthday') || q.includes('born')) return `Joyal was born on ${personal.dateOfBirth} 🎂. He is ${new Date().getFullYear() - 2001 - (new Date() < new Date(`${new Date().getFullYear()}-08-23`) ? 1 : 0)} years old.`;
      if (q.includes('hobby') || q.includes('hobbies') || q.includes('interest') || q.includes('free time')) return `Joyal enjoys ${personal.hobbies.join(' and ')}.`;
      if (q.includes('language') || q.includes('speak')) return `Joyal speaks ${personal.languages.join(' and ')} 🗣️.`;
      if (q.includes('personality') || q.includes('character') || q.includes('kind of person')) return personal.personality;
      if (q.includes('favorite place') || q.includes('favourite place') || q.includes('dream place')) return `Joyal's favorite place would be ${personal.favoritePlace}`;
      if (q.includes('car') || q.includes('vehicle')) return `Joyal's favorite car is the ${personal.favoriteCar}`;
      if (q.includes('food') || q.includes('dish') || q.includes('eat')) return `Joyal's favorite food is ${personal.favoriteFood}`;
      if (q.includes('college') || q.includes('university') || q.includes('degree') || q.includes('bachelor') || q.includes('study') || q.includes('education')) return `Joyal studied ${education.degree.role} at ${education.degree.place} from ${education.degree.year}. He also completed ${education.fullStack.role} at ${education.fullStack.place} and ${education.higherSecondary.role} at ${education.higherSecondary.place}.`;
      if (q.includes('place') || q.includes('live') || q.includes('based') || q.includes('location')) return 'Joyal is based in Sharjah, United Arab Emirates.';
      if (q.includes('skill') || q.includes('tech') || q.includes('stack')) return 'Joyal works across the full stack with React, Next.js, TypeScript, NestJS, PostgreSQL, and modern web tooling.';
      if (q.includes('project') || q.includes('build') || q.includes('work')) return 'He builds practical business software, including multi-branch ERP systems, equipment-rental tools, APIs, and responsive web applications.';
      if (q.includes('who') || q.includes('about') || q.includes('location') || q.includes('where')) return bio;
      if (q.includes('resume') || q.includes('cv')) return `You can <a href="${resume}" download>download Joyal's resume</a>.`;
      return 'I can help with Joyal’s background, skills, projects, location, resume, or contact details. Try asking one of those.';
    };
    const addMessage = (text, type) => {
      const item = document.createElement('div');
      item.className = `about-bot__message about-bot__message--${type}`;
      item.innerHTML = text;
      messages.append(item);
      messages.scrollTop = messages.scrollHeight;
    };
    const related = [
      ['phone|mobile|number|call', 'What is Joyal’s phone number?'],
      ['place|live|based|location', 'Where is Joyal based?'],
      ['hobby|interest|free time', 'What are Joyal’s hobbies?'],
      ['age|old|birthday', 'How old is Joyal?'],
      ['father|dad', 'What is Joyal’s father’s name?'],
      ['family|parents|home', 'Tell me about Joyal’s family.'],
      ['college|university|degree|study|education', 'Which college and degree did Joyal complete?'],
      ['language|speak', 'Which languages does Joyal speak?'],
      ['personality|character', 'What is Joyal’s personality like?'],
      ['car|vehicle', 'What is Joyal’s favorite car?'],
      ['food|dish|eat', 'What is Joyal’s favorite food?'],
      ['skill|tech|stack', 'What are Joyal’s skills?'],
    ];
    const updateRelated = (value) => {
      const promptBox = root.querySelector('.about-bot__prompts');
      const matches = related.filter(([words]) => new RegExp(words, 'i').test(value)).map(([, text]) => text);
      promptBox.innerHTML = '';
      matches.slice(0, 3).forEach((text) => { const button = document.createElement('button'); button.type = 'button'; button.dataset.question = text; button.textContent = text; button.addEventListener('click', () => ask(text)); promptBox.append(button); });
    };
    const ask = (question) => { if (!question.trim()) return; addMessage(question, 'user'); window.setTimeout(() => addMessage(answer(question), 'bot'), 220); };
    const open = () => { panel.hidden = false; launcher.setAttribute('aria-expanded', 'true'); window.setTimeout(() => input.focus(), 50); };
    launcher.addEventListener('click', open);
    close.addEventListener('click', () => { panel.hidden = true; launcher.setAttribute('aria-expanded', 'false'); launcher.focus(); });
    form.addEventListener('submit', (event) => { event.preventDefault(); ask(input.value); input.value = ''; });
    input.addEventListener('input', () => updateRelated(input.value));
    root.querySelectorAll('[data-question]').forEach((button) => button.addEventListener('click', () => ask(button.dataset.question || '')));
  }
</script>
