---
import { NB } from '../lib/notebook';
import { Image } from 'astro:assets';
import blackShirtPortrait from '../../public/media/joyal-portrait-black-shirt.png';
import portrait from '../../public/media/joyal-portrait.png';

interface Props {
  width?: number | string;
  height?: number | string;
  rotate?: number;
  label?: string;
  src?: string | null;
  alt?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  [key: string]: unknown;
}

const cssSize = (v: string | number) => typeof v === 'number' ? v + 'px' : v;

const {
  width = 130,
  height = 170,
  rotate = -3,
  label = 'drop photo',
  src = null,
  alt = '',
  class: className,
  loading = 'lazy',
  ...rest
} = Astro.props;

const wStyle = cssSize(width);
const hStyle = cssSize(height);
const optimizedPhoto = src === '/media/joyal-portrait-black-shirt.png' ? blackShirtPortrait : src === '/media/joyal-portrait.png' ? portrait : undefined;
const accessibleAlt = alt || label;
---

<div
  class={`nb-photo${className ? ' ' + className : ''}`}
  style={`width: ${wStyle}; height: ${hStyle}; transform: rotate(${rotate}deg);`}
  {...rest}
>
  <div class="nb-photo-inner">
    {optimizedPhoto ? (
      <Image src={optimizedPhoto} alt={accessibleAlt} widths={[220, 440, 660]} sizes="(min-width: 880px) 280px, (min-width: 601px) 33vw, 220px" width={440} format="webp" quality={82} loading={loading} fetchpriority={loading === 'eager' ? 'high' : 'auto'} decoding="async" style="width: 100%; height: 100%; object-fit: cover;" />
    ) : src ? (
      <img
        src={src}
        alt={accessibleAlt}
        loading={loading}
        decoding="async"
        style="width: 100%; height: 100%; object-fit: cover;"
      />
    ) : (
      <div class="nb-photo-placeholder">
        <svg viewBox="0 0 100 130" style="width: 60%; height: 60%; opacity: 0.45;">
          <circle cx="50" cy="42" r="20" fill="none" stroke={NB.pencil} stroke-width="2" />
          <path
            d="M15,125 C15,90 35,80 50,80 C65,80 85,90 85,125"
            fill="none"
            stroke={NB.pencil}
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
        <span style={`font-family: 'JetBrains Mono', monospace; font-size: 9px; color: ${NB.pencil}; margin-top: 6px; letter-spacing: 0.5px;`}>{label}</span>
      </div>
    )}
  </div>
</div>
