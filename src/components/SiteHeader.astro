---
import { navigation } from '../lib/navigation';
const path = Astro.url.pathname;
---
<header class="site-header">
  <a class="site-brand" href="/" aria-label="Joyal Varghese — home">// joyal.varghese <span>software developer</span></a>
  <nav aria-label="Main navigation">
    {navigation.map(({ href, label }) => (
      <a href={href} aria-current={(href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, ''))) ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
</header>
<style>
  .site-header { padding: 18px var(--nb-pad) 12px; border-bottom: 1px dashed rgba(90,90,90,.4); }
  .site-brand { display: inline-block; font: 11px/1.6 'JetBrains Mono', monospace; text-decoration: none; letter-spacing: .5px; padding: 4px 0; }
  .site-brand span { display: block; color: var(--nb-pencil); font-size: 10px; }
  nav { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 12px; gap: 2px 8px; }
  nav a { display: flex; align-items: center; justify-content: center; min-height: 44px; padding: 7px 2px; font-size: 18px; text-decoration: none; border-radius: 3px; white-space: nowrap; }
  nav a:hover, nav a[aria-current='page'] { background: linear-gradient(transparent 25%, var(--nb-yellow) 25%, var(--nb-yellow) 80%, transparent 80%); }
  nav a[aria-current='page'] { font-weight: 700; }
  @media (min-width: 880px) {
    .site-header { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding-top: 20px; }
    nav { display: flex; gap: 16px; margin-top: 0; }
    nav a { padding-inline: 5px; font-size: 20px; }
  }
</style>
