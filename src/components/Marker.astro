---
import { NB } from '../lib/notebook';

interface Props {
  size?: number | string;
  color?: string;
  as?: string;
  class?: string;
  style?: string;
  [key: string]: unknown;
}

const cssSize = (v: string | number) => typeof v === 'number' ? v + 'px' : v;

const { size = 48, color = NB.ink, as: Tag = 'span', class: className, style = '', ...rest } = Astro.props;
const fontSize = cssSize(size);
---

<Tag
  class={className}
  style={`font-family: "Permanent Marker", cursive; font-size: ${fontSize}; color: ${color}; line-height: 1.05; letter-spacing: 0.5px; display: inline-block; ${style}`}
  {...rest}
><slot /></Tag>
