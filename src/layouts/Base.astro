---
// Base layout: <head>, fonts, global styles, cross-page transitions.
// Every page wraps its content in this. The page body content should be a
// single GridPaper so the notebook paper fills the viewport.
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import profile from '../content/profile/main.json';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  structuredData?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title = 'Joyal Varghese · Portfolio',
  description = 'Joyal Varghese, full-stack developer in Sharjah, UAE, building web applications and ERP systems.',
  type = 'website',
  structuredData,
  noindex = false,
} = Astro.props;
const pathname = Astro.url.pathname.endsWith('.html') ? Astro.url.pathname : `${Astro.url.pathname.replace(/\/$/, '')}/`;
const canonical = Astro.site ? new URL(pathname, Astro.site).href : undefined;
const image = Astro.site && profile.photo ? new URL(profile.photo, Astro.site).href : undefined;
const homeData = pathname === '/' ? {
  '@context': 'https://schema.org', '@type': 'ProfilePage', url: canonical,
  mainEntity: {
    '@type': 'Person', name: profile.name, jobTitle: 'Full Stack Software Developer',
    description, image, url: canonical,
    sameAs: profile.contacts.filter((contact) => contact.sub === 'linkedin').map((contact) => contact.url),
    homeLocation: { '@type': 'Place', name: 'Sharjah, United Arab Emirates' },
    knowsAbout: ['React', 'Next.js', 'NestJS', 'TypeScript', 'PostgreSQL', 'ERP development'],
  },
} : undefined;
const schema = structuredData ?? homeData;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Joyal Varghese" />
    <meta property="og:locale" content="en_GB" />
    {canonical && <meta property="og:url" content={canonical} />}
    {image && <meta property="og:image" content={image} />}
    {image && <meta property="og:image:alt" content="Joyal Varghese, full stack developer in Sharjah, UAE" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Kalam:wght@300;400;700&family=Permanent+Marker&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    {/* Enables scroll-reveal styles; runs before paint so content never flashes. */}
    <script is:inline>document.documentElement.classList.add('js');</script>

    <ClientRouter />
  </head>
  <body>
    {/* Capture the whole rendered page so scoped styles survive the turn. */}
    <main>
      <slot />
    </main>

    <script>
      // Scroll-reveal: fade + rise [data-reveal] elements as they enter view.
      // Auto-staggers items that appear together; respects reduced-motion;
      // re-runs after every client-side navigation (astro:page-load).
      let revealObserver: IntersectionObserver | null = null;
      function initReveal() {
        revealObserver?.disconnect();
        const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
        if (!els.length) return;

        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) {
          els.forEach((el) => el.classList.add('is-revealed'));
          return;
        }

        const io = new IntersectionObserver(
          (entries, obs) => {
            entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)
              .forEach((entry, i) => {
                const el = entry.target as HTMLElement;
                el.style.transitionDelay = i * 85 + 'ms';
                el.classList.add('is-revealed');
                obs.unobserve(el);
                // Once the fade finishes, drop the attribute so it no longer
                // overrides component hover transitions.
                el.addEventListener('transitionend', function done(ev) {
                  if ((ev as TransitionEvent).propertyName !== 'opacity') return;
                  el.removeEventListener('transitionend', done);
                  el.style.transitionDelay = '';
                  el.removeAttribute('data-reveal');
                });
              });
          },
          { threshold: 0.1, rootMargin: '0px 0px -8% 0px' },
        );

        revealObserver = io;
        els.forEach((el) => io.observe(el));
      }

      document.addEventListener('astro:page-load', initReveal);

      // Page-flip sound: plays as a navigation begins (still inside the
      // click gesture, so autoplay policy lets it through). Reused, lazily
      // created; play() rejection (blocked / no gesture) is swallowed.
      let flipAudio: HTMLAudioElement | null = null;
      function playFlip() {
        try {
          if (!flipAudio) {
            flipAudio = new Audio('/page-flip-sound.mp3');
            flipAudio.preload = 'auto';
            flipAudio.volume = 0.55;
          }
          flipAudio.currentTime = 0;
          flipAudio.play().catch(() => {});
        } catch {
          /* no-op */
        }
      }
      document.addEventListener('astro:before-preparation', playFlip);

      // Set direction before Astro captures the rendered outgoing page.
      // Native snapshots retain scoped CSS without cloning the page DOM.
      document.addEventListener('astro:before-preparation', (event) => {
        const depth = (url: URL) => url.pathname.split('/').filter(Boolean).length;
        if (depth(event.to) < depth(event.from)) event.direction = 'back';
      });

      document.addEventListener('astro:before-swap', (event) => {
        revealObserver?.disconnect();
        event.newDocument.documentElement.classList.add('js');
      });

      // Resolve above-the-fold reveals before the destination snapshot.
      // Otherwise the page turn exposes hidden content that pops in afterward.
      document.addEventListener('astro:after-swap', () => {
        document.querySelectorAll<HTMLElement>('main [data-reveal]').forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            el.removeAttribute('data-reveal');
            el.style.transitionDelay = '';
          }
        });
      });
    </script>
  </body>
</html>
