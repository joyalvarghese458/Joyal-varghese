---
// Base layout: <head>, fonts, global styles, cross-page transitions.
// Every page wraps its content in this. The page body content should be a
// single GridPaper so the notebook paper fills the viewport.
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import profile from '../content/profile/main.json';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AboutMeBot from '../components/AboutMeBot.astro';
import { navigation } from '../lib/navigation';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  structuredData?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title = 'Joyal Varghese | Full-Stack Software Developer in Sharjah, UAE',
  description = 'Joyal Varghese is a full-stack software developer in Sharjah, UAE, building web applications, ERP systems, APIs, and practical business tools.',
  type = 'website',
  structuredData,
  noindex = false,
} = Astro.props;
const pathname = Astro.url.pathname.endsWith('.html') ? Astro.url.pathname : `${Astro.url.pathname.replace(/\/$/, '')}/`;
const canonical = Astro.site ? new URL(pathname, Astro.site).href : undefined;
const image = Astro.site && profile.photo ? new URL(profile.photo, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/media/og-image.png', Astro.site).href : undefined;
const origin = Astro.site?.href;
const personId = origin ? `${origin}#person` : undefined;
const pageLabel = navigation.find((item) => item.href === pathname)?.label ?? title.split('|')[0].trim();
const parent = navigation.find((item) => item.href !== '/' && pathname.startsWith(item.href) && pathname !== item.href);
const breadcrumbs = [
  { name: 'Home', path: '/' },
  ...(parent ? [{ name: parent.label, path: parent.href }] : []),
  ...(pathname !== '/' ? [{ name: pageLabel, path: pathname }] : []),
];
const schema = origin && !noindex ? {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${origin}#website`, url: origin, name: `${profile.name} — Software Developer`, inLanguage: 'en', publisher: { '@id': personId } },
    {
      '@type': 'Person', '@id': personId, name: profile.name, jobTitle: 'Software Developer',
      description: profile.bio, image, url: new URL('/about/', origin).href,
      sameAs: profile.contacts.filter((contact) => ['linkedin', 'instagram'].includes(contact.sub)).map((contact) => contact.url),
      homeLocation: { '@type': 'Place', name: 'Sharjah, United Arab Emirates' },
      knowsAbout: ['React', 'Next.js', 'NestJS', 'TypeScript', 'PostgreSQL', 'ERP development'],
    },
    {
      '@type': 'ProfessionalService', '@id': `${origin}#professional-service`,
      name: `${profile.name} — Software Developer`, url: origin,
      description: 'Full-stack software development services in Sharjah, UAE, including web applications, ERP systems, APIs, and business tools.',
      provider: { '@id': personId },
      areaServed: [{ '@type': 'City', name: 'Sharjah' }, { '@type': 'City', name: 'Dubai' }, { '@type': 'Country', name: 'United Arab Emirates' }],
      serviceType: ['Web application development', 'ERP development', 'API development', 'E-commerce development'],
    },
    {
      '@type': pathname === '/about/' ? 'ProfilePage' : pathname === '/contact/' ? 'ContactPage' : 'WebPage',
      '@id': `${canonical}#webpage`, url: canonical, name: title, description, inLanguage: 'en',
      isPartOf: { '@id': `${origin}#website` }, about: { '@id': personId },
      ...(pathname === '/about/' ? { mainEntity: { '@id': personId } } : {}),
      ...(pathname !== '/' ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
    },
    ...(pathname !== '/' ? [{
      '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`,
      itemListElement: breadcrumbs.map((item, i) => ({ '@type': 'ListItem', position: i + 1, name: item.name, item: new URL(item.path, origin).href })),
    }] : []),
    ...(structuredData ? [structuredData] : []),
  ],
} : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="yh0V7poJGf5mZJarZGaJFcPz4KWtXkoaeGlFdHqxv6I" />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#fbfaf5" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Joyal Varghese" />
    <meta property="og:locale" content="en_GB" />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:secure_url" content={ogImage} />}
    {ogImage && <meta property="og:image:type" content="image/png" />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content="Joyal Varghese, software developer in Sharjah, UAE" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content="Joyal Varghese — software developer in Sharjah, UAE" />}
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Kalam:wght@300;400;700&family=Permanent+Marker&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-notebook">
      <SiteHeader />
      <main id="main-content" tabindex="-1"><slot /></main>
      <SiteFooter />
      <AboutMeBot />
    </div>

    <script>
      // Scroll-reveal: fade + rise [data-reveal] elements as they enter view.
      // Auto-staggers items that appear together; respects reduced-motion;
      // re-runs after every client-side navigation (astro:page-load).
      let revealObserver: IntersectionObserver | null = null;
      function initReveal() {
        revealObserver?.disconnect();
        const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
        if (!els.length) return;

        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-revealed'));
          return;
        }

        const io = new IntersectionObserver(
          (entries, obs) => {
            entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)
              .forEach((entry, i) => {
                const el = entry.target as HTMLElement;
                el.style.transitionDelay = i * 85 + 'ms';
                el.classList.add('is-revealed');
                obs.unobserve(el);
                // Once the fade finishes, drop the attribute so it no longer
                // overrides component hover transitions.
                el.addEventListener('transitionend', function done(ev) {
                  if ((ev as TransitionEvent).propertyName !== 'opacity') return;
                  el.removeEventListener('transitionend', done);
                  el.style.transitionDelay = '';
                  el.removeAttribute('data-reveal');
                });
              });
          },
          { threshold: 0.1, rootMargin: '0px 0px -8% 0px' },
        );

        revealObserver = io;
        document.documentElement.classList.add('js');
        els.forEach((el) => io.observe(el));
      }

      document.addEventListener('astro:page-load', initReveal);

      document.addEventListener('astro:before-swap', (event) => {
        revealObserver?.disconnect();
      });

      // Resolve above-the-fold reveals before the destination snapshot.
      // Otherwise the page turn exposes hidden content that pops in afterward.
      document.addEventListener('astro:after-swap', () => {
        document.querySelectorAll<HTMLElement>('main [data-reveal]').forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            el.removeAttribute('data-reveal');
            el.style.transitionDelay = '';
          }
        });
      });
    </script>
  </body>
</html>
